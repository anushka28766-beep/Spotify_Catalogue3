        "# 1. Check missing values & drop rows missing key info\n",
        "print(\"Missing values before cleaning:\\n\", df.isnull().sum()[df.isnull().sum() > 0])\n",
        "df = df.dropna(subset=['artists', 'track_name', 'popularity', 'duration_ms']).copy()\n",
        "\n",
        "# 2. Remove duplicate tracks (keeping highest popularity version)\n",
        "before_dups = len(df)\n",
        "df = df.sort_values('popularity', ascending=False).drop_duplicates(\n",
        "    subset=['track_name', 'artists'], keep='first'\n",
        ")\n",
        "print(f\"Removed {before_dups - len(df)} duplicate track entries.\")\n",
        "\n",
        "# 3. NumPy feature engineering: duration in minutes & popularity tier\n",
        "df['duration_min'] = np.round(df['duration_ms'] / 60000, 2)\n",
        "\n",
        "conditions = [\n",
        "    df['popularity'] >= 75,\n",
        "    (df['popularity'] >= 40) & (df['popularity'] < 75),\n",
        "    df['popularity'] < 40,\n",
        "]\n",
        "choices = ['Hit', 'Moderate', 'Niche']\n",
        "df['popularity_tier'] = np.select(conditions, choices, default='Unknown')\n",
        "\n",
        "# 4. Count how many artists are credited on each track\n",
        "df['num_artists'] = df['artists'].astype(str).str.count(';') + 1\n",
        "\n",
        "print(\"Cleaned shape:\", df.shape)\n",
        "print(\"\\nPopularity Tier counts:\\n\", df['popularity_tier'].value_counts())"
